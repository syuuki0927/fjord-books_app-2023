<p style="color: green"><%= notice %></p>

<h1><%= Book.model_name.human %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to Book.human_attribute_name("show_button"), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to Book.human_attribute_name("new_button"), new_book_path %>
</nav>
