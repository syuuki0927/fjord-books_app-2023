<div id="<%= dom_id comment %>">
    <div class="comment-header">
      <div class="comment-user">
        <% if comment.user.avatar.attached? %>
          <%= image_tag comment.user.avatar.variant(:icon_inline) %>
        <% end %>
        <%= link_to([comment.user.name, comment.user.email].find(&:present?), comment.user) %>
      </div>
      <span class="span-small">
        <%= comment.created_at %>
      </span>
    </div>
  <p>
    <%= comment.body %>
  </p>

  <% if comment.user == current_user %>
    <div style="width: 100%; text-align: right;">
      <%= link_to "Edit this comment", edit_comment_path(comment) %>
      <%= button_to "Destroy this rcomment", comment, method: :delete%>
    </div>
  <% end %>
</div>
