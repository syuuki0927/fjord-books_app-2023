<%= render @report %>

<div>
  <% if @report.user == current_user %>
    <%= link_to "Edit this report", edit_report_path(@report) %> |
  <% end %>
  <%= link_to "Back to reports", reports_path %>
  <% if @report.user == current_user %>
    <%= button_to "Destroy this report", @report, method: :delete %>
  <% end %>
</div>

<div id="comments" class="comments">
  <% if @report.comment.length > 0 %>
    <% @report.comment.each do |comment| %>
      <div class="index-item">
        <%= render comment %>
      </div>
    <% end %>
  <% else %>
    コメントはまだありません
  <% end %>

  <%= render "comments/form", comment: @report.comment.new(commentable: @report) %>
</div>
